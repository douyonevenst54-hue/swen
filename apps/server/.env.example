# Postgres connection. On Neon, use the POOLED connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/swen?sslmode=require"
# On Neon, the DIRECT (non-pooled) connection string, used only for migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/swen?sslmode=require"

# Supervisor dashboard password. Use a long passphrase.
ADMIN_PASSWORD="change-me-to-a-long-passphrase"

# 32+ random characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# 32 random bytes, base64. Encrypts each device's data key at rest. Generate with:
#   openssl rand -base64 32
# Keep a safe offline copy: if it is lost, devices must be set up again.
KEY_ENCRYPTION_KEY=""

# How long a staff member's sync session lasts before they must unlock online again.
STAFF_SESSION_DAYS=7
